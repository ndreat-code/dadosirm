# ── DADO CRM .gitignore ────────────────────────────────────────

# File di configurazione e variabili d'ambiente (CHIAVI PRIVATE & SEGRETI)
.env
.env*.local
.env.development
.env.test
.env.production

# Credenziali Google Cloud OAuth2 e Token di autenticazione Gmail / Drive
credentials.json
tokens.json
google_tokens.json
google_credentials.json
server/data/google_tokens.json
server/data/google_credentials.json

# Dipendenze Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Output di compilazione / produzione Vite
dist/
dist-ssr/
build/
*.local

# File di sistema macOS & Windows
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log e directory temporanee
logs/
*.log
scratch/
.system_generated/

# Configurazione Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
